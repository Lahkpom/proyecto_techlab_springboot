# =============================================================================
# ENTORNO, CORS Y LOGS DE BASE DE DATOS
# =============================================================================

# DESCOMENTAR SOLO EN PRODUCCIÓN
# Indica que el sistema debe usar los métodos productivos
#SPRING_PROFILES_ACTIVE=prod

# Lista separada por comas de orígenes permitidos por CORS (en producción usar el dominio de Vercel).
CORS_ALLOWED_ORIGINS=https://dummy-frontend.example.invalid

# Esto es para que muestre por consola la interacción entre el back y la db
# (usar true solo en desarrollo local; false en producción).
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_FORMAT_SQL=false

# =============================================================================
# ENTORNO, CORS Y LOGS DE BASE DE DATOS
# =============================================================================

# =============================================================================
# SEGURIDAD & AUTENTICACIÓN JWT
# =============================================================================

# Clave secreta en Base64 para firmar los JWT (mínimo 256 bits).
# Genera una con: openssl rand -base64 32
SPRING_SECRET_SHA256_KEY=DUMMY_JWT_SECRET_NOT_FOR_USE

# Duración del Access Token en milisegundos (ej: 15 minutos = 900000 ms).
SPRING_JWT_EXPIRATION=1234567

# Contraseña inicial para cuentas de operador o mayorista que requieran cambio de contraseña.
SPRING_INITIAL_USER_PASSWORD=DUMMY_INITIAL_PASSWORD_NOT_FOR_USE

# =============================================================================
# SEGURIDAD & AUTENTICACIÓN JWT
# =============================================================================

# =============================================================================
# BASE DE DATOS POSTGRESQL
# =============================================================================

# URL JDBC de PostgreSQL. Incluye el host, puerto, base de datos y parámetros SSL
# que indique tu proveedor. Ejemplo: jdbc:postgresql://HOST:5432/BASE_DE_DATOS?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://dummy-db.example.invalid:5432/dummy?sslmode=require

# Usuario y contraseña de la base de datos PostgreSQL.
SPRING_DATASOURCE_USERNAME=DUMMY_DATABASE_USER
SPRING_DATASOURCE_PASSWORD=DUMMY_DATABASE_PASSWORD_NOT_FOR_USE

# =============================================================================
# BASE DE DATOS POSTGRESQL
# =============================================================================

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================

# URL del proyecto Supabase (Project URL, por ejemplo https://<project-ref>.supabase.co).
SUPABASE_URL=https://dummy-project.example.invalid

# Secret key del proyecto Supabase; no uses ni publiques una clave real en este archivo.
SUPABASE_SECRET_KEY=DUMMY_SUPABASE_SECRET_NOT_FOR_USE

# Nombre exacto del bucket de Supabase Storage utilizado para las imágenes.
SUPABASE_STORAGE_BUCKET=dummy-images

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================

# =============================================================================
# PURGA AUTOMÁTICA DE ÓRDENES VENCIDAS (TTL)
# =============================================================================

# Expresión cron: Segundo Minuto Hora Día Mes Día-de-la-semana ("0 0 3 * * *" = 03:00 AM todos los días).
SALES_EXPIRATION_CRON=0 17 4 * * *

# Zona horaria para ejecutar el scheduler.
SALES_EXPIRATION_ZONE=Etc/UTC

# Tiempo de vida en horas para órdenes pendientes digitales (Mercado Pago / Transferencia) y en efectivo.
SALES_EXPIRATION_TTL_HOURS=37
SALES_EXPIRATION_CASH_TTL_HOURS=73

# =============================================================================
# PURGA AUTOMÁTICA DE ÓRDENES VENCIDAS (TTL)
# =============================================================================

# =============================================================================
# MERCADO PAGO CONFIGURATION
# =============================================================================

# Token de acceso para autenticar llamadas a la API de Mercado Pago.
# DÓNDE OBTENERLO: Panel de Desarrolladores de MP (mercadopago.com.ar/developers) -> "Tus integraciones" -> Seleccionar Aplicación -> "Credenciales de prueba" (o producción) -> "Access token".
# Formato típico: "TEST-..." (para sandbox) o "APP_USR-..." (para producción).
MP_ACCESS_TOKEN=DUMMY_MP_ACCESS_TOKEN_NOT_FOR_USE

# Clave secreta para verificar la firma HMAC-SHA256 en las notificaciones del Webhook y evitar suplantación de identidad.
# DÓNDE OBTENERLO: En el mismo panel de tu aplicación -> "Notificaciones" -> "Webhooks" -> "Firma secreta" (Secret Signature).
MP_WEBHOOK_SECRET=DUMMY_MP_WEBHOOK_SECRET_NOT_FOR_USE

# URL pública donde tu backend recibirá los Webhooks de Mercado Pago.
# DÓNDE OBTENERLO:
# - En producción: Es la URL de tu dominio (ej: https://api.tudominio.com/api/v1/payments/mercadopago/webhook).
# - En desarrollo local: Tu localhost:8080 no es visible en internet; se usa ngrok o cloudflared para tunelizarlo (ej: https://subdominio.ngrok-free.app/api/v1/payments/mercadopago/webhook).
MP_NOTIFICATION_URL=https://dummy-backend.example.invalid/api/webhook

# URLs de retorno hacia tu frontend en React tras finalizar el flujo en Mercado Pago.
# DÓNDE OBTENERLO: Son las rutas que creás en tu frontend con React Router.
MP_BACK_URL_SUCCESS=http://localhost:5173/checkout/success
MP_BACK_URL_FAILURE=http://localhost:5173/checkout/failure
MP_BACK_URL_PENDING=http://localhost:5173/checkout/pending
# Solo para usar en desarrollo, imita el pago por mercado pago
MP_SANDBOX_URL=http://localhost:5173/checkout/mp-sandbox

# =============================================================================
# MERCADO PAGO CONFIGURATION
# =============================================================================

# =============================================================================
# MÓDULO FISCAL (ARCA / EX-AFIP) - FACTURACIÓN ELECTRÓNICA
# =============================================================================

# CUIT de la tienda emisora (11 dígitos sin guiones).
# Origen: Constancia de inscripción en ARCA / AFIP del titular monotributista.
ARCA_CUIT=00000000000

# Punto de Venta habilitado exclusivamente para Facturación Electrónica (Web Service).
# Origen: Administrador de Puntos de Venta y Domicilios en el portal con clave fiscal de ARCA.
# NOTA: No uses el de facturación manual de talonario ni el de 'Comprobantes en Línea'.
ARCA_PUNTO_VENTA=0

# Ruta absoluta o relativa al certificado digital (.crt) emitido por ARCA.
# Origen: Generado mediante CSR en el portal de ARCA con Clave Fiscal Nivel 3.
ARCA_CERT_PATH=/dummy/arca/certificate.crt

# Ruta absoluta o relativa a la clave privada (.key) con la que se generó el CSR.
# Origen: Archivo .key generado localmente con OpenSSL al crear el pedido de certificado.
ARCA_KEY_PATH=/dummy/arca/private.key

# URL del Web Service de Autenticación y Autorización (WSAA)
# Homologación (Testing): https://wsaahomo.afip.gov.ar/ws/services/LoginCms
# Producción: https://wsaa.afip.gov.ar/ws/services/LoginCms
ARCA_WSAA_URL=https://dummy-wsaa.example.invalid/LoginCms

# URL del Web Service de Factura Electrónica (WSFEV1)
# Homologación (Testing): https://wswhomo.afip.gov.ar/wsfev1/service.asmx
# Producción: https://servicios1.afip.gov.ar/wsfev1/service.asmx
ARCA_WSFE_URL=https://dummy-wsfe.example.invalid/service.asmx

# Tope legal de facturación a consumidor final anónimo sin DNI/CUIT (RG AFIP/ARCA)
ARCA_ANONYMOUS_INVOICE_LIMIT=123.45

# =============================================================================
# MÓDULO FISCAL (ARCA / EX-AFIP) - FACTURACIÓN ELECTRÓNICA
# =============================================================================