# Clave secreta en Base64 para firmar los JWT (mínimo 256 bits).
# Genera una con: openssl rand -base64 32
SPRING_SECRET_SHA256_KEY=REEMPLAZAR_POR_UNA_CLAVE_BASE64

# URL JDBC de PostgreSQL. Incluye el host, puerto, base de datos y parámetros SSL
# que indique tu proveedor. Ejemplo: jdbc:postgresql://HOST:5432/BASE_DE_DATOS?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/BASE_DE_DATOS?sslmode=require
# Usuario y contraseña de la base de datos PostgreSQL.
SPRING_DATASOURCE_USERNAME=REEMPLAZAR_POR_EL_USUARIO
SPRING_DATASOURCE_PASSWORD=REEMPLAZAR_POR_LA_CONTRASENA

# URL del proyecto Supabase (Project URL, por ejemplo https://<project-ref>.supabase.co).
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Secret key del proyecto Supabase; no uses ni publiques una clave real en este archivo.
SUPABASE_SECRET_KEY=REEMPLAZAR_POR_LA_SECRET_KEY
# Nombre exacto del bucket de Supabase Storage utilizado para las imágenes.
SUPABASE_STORAGE_BUCKET=REEMPLAZAR_POR_EL_NOMBRE_DEL_BUCKET
