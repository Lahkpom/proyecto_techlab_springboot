# Clave secreta en Base64 para firmar los JWT (mínimo 256 bits).
# Genera una con: openssl rand -base64 32
SPRING_SECRET_SHA256_KEY=REEMPLAZAR_POR_UNA_CLAVE_BASE64

# URL JDBC de PostgreSQL. Incluye el host, puerto, base de datos y parámetros SSL
# que indique tu proveedor. Ejemplo: jdbc:postgresql://HOST:5432/BASE_DE_DATOS?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/BASE_DE_DATOS?sslmode=require
# Usuario y contraseña de la base de datos PostgreSQL.
SPRING_DATASOURCE_USERNAME=REEMPLAZAR_POR_EL_USUARIO
SPRING_DATASOURCE_PASSWORD=REEMPLAZAR_POR_LA_CONTRASENA

# URL del proyecto Supabase (Project URL, por ejemplo https://<project-ref>.supabase.co).
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Secret key del proyecto Supabase; no uses ni publiques una clave real en este archivo.
SUPABASE_SECRET_KEY=REEMPLAZAR_POR_LA_SECRET_KEY
# Nombre exacto del bucket de Supabase Storage utilizado para las imágenes.
SUPABASE_STORAGE_BUCKET=REEMPLAZAR_POR_EL_NOMBRE_DEL_BUCKET

# =============================================================================
# MERCADO PAGO CONFIGURATION
# =============================================================================

# Token de acceso para autenticar llamadas a la API de Mercado Pago.
# DÓNDE OBTENERLO: Panel de Desarrolladores de MP (mercadopago.com.ar/developers) -> "Tus integraciones" -> Seleccionar Aplicación -> "Credenciales de prueba" (o producción) -> "Access token".
# Formato típico: "TEST-..." (para sandbox) o "APP_USR-..." (para producción).
MP_ACCESS_TOKEN=TEST-1234567890123456-102914-abcdef1234567890abcdef1234567890-123456789

# Clave secreta para verificar la firma HMAC-SHA256 en las notificaciones del Webhook y evitar suplantación de identidad.
# DÓNDE OBTENERLO: En el mismo panel de tu aplicación -> "Notificaciones" -> "Webhooks" -> "Firma secreta" (Secret Signature).
MP_WEBHOOK_SECRET=a1b2c3d4e5f67890123456789abcdef0123456789abcdef0123456789abcdef

# URL pública donde tu backend recibirá los Webhooks de Mercado Pago.
# DÓNDE OBTENERLO:
# - En producción: Es la URL de tu dominio (ej: https://api.tudominio.com/api/v1/payments/mercadopago/webhook).
# - En desarrollo local: Tu localhost:8080 no es visible en internet; se usa ngrok o cloudflared para tunelizarlo (ej: https://subdominio.ngrok-free.app/api/v1/payments/mercadopago/webhook).
MP_NOTIFICATION_URL=https://subdominio.ngrok-free.app/api/v1/payments/mercadopago/webhook

# URLs de retorno hacia tu frontend en React tras finalizar el flujo en Mercado Pago.
# DÓNDE OBTENERLO: Son las rutas que creás en tu frontend con React Router.
MP_BACK_URL_SUCCESS=http://localhost:5173/checkout/success
MP_BACK_URL_FAILURE=http://localhost:5173/checkout/failure
MP_BACK_URL_PENDING=http://localhost:5173/checkout/pending

# =============================================================================
# MERCADO PAGO CONFIGURATION
# =============================================================================